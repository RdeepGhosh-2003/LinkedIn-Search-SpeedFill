{
  "manifest_version": 3,
  "name": "LinkedIn SpeedFill Auto-Apply Engine",
  "version": "1.0.0",
  "description": "Sub-10ms auto-filler and search auto-apply assistant for LinkedIn Easy Apply jobs in Chrome & Brave.",
  "permissions": [
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "scripts/matcher.js",
        "scripts/linkedin_search.js",
        "scripts/linkedin_easy_apply.js"
      ],
      "css": [
        "scripts/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill_form": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Instant trigger auto-fill on current LinkedIn Easy Apply modal"
    }
  }
}
